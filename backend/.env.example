# Copy this file to .env and fill in your key
GOOGLE_API_KEY=your-gemini-api-key

# Leave QDRANT_URL empty to use local file mode (no Docker needed).
# If you run Qdrant in Docker:  QDRANT_URL=http://localhost:6333
QDRANT_URL=

LLM_MODEL=gemini-2.5-flash
EMBED_MODEL=models/gemini-embedding-001
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Which collection the chat uses by default (docs_fixed or docs_recursive)
ACTIVE_COLLECTION=docs_recursive

# Cross-encoder score below which we say "no relevant context found"
MIN_RERANK_SCORE=-1.0
